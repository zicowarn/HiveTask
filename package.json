{
  "name": "hivetask",
  "version": "0.1.0",
  "description": "HiveTask — cross-platform desktop project management tool (Tauri + Vue)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:rust": "cargo clippy --all-targets",
    "format": "prettier --write src",
    "gate": "bash scripts/gate.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@web-git-graph/protocol": "^1.0.7",
    "@web-git-graph/web": "^1.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "markdown-it": "^15.0.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}

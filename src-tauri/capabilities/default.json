{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for HiveTask main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "store:default",
    "log:default",
    "opener:allow-reveal-item-in-dir",
    "clipboard-manager:allow-write-text",
    "notification:default"
  ]
}
